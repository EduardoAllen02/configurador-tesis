// Esquema de base de datos — Sistema de configuración de tours virtuales 360°.
// Sistema de una sola empresa (sin organizaciones/multi-tenant): los tours pertenecen
// directo al sistema. RBAC de dos niveles (Fase 2.0):
//   - Rol global (User.globalRole): super_admin | admin | member. Superadmin y Admin
//     operan sobre cualquier tour sin necesitar TourPermission; solo Superadmin puede
//     escalar roles de otros usuarios o borrar de forma irreversible (tours, cuentas).
//   - Rol por tour (TourPermission.role): cliente, para el usuario final dueño de un
//     tour puntual. Ve y edita escenas, hotspots y apariencia.
//
// Las escenas soportan dos orígenes de navegación (campo `origen`):
//   - video_frame: frame extraído de un video 360° subido (ver VideoUpload + FFmpeg/Sharp)
//   - panorama_upload: panorámica estática subida directamente, sin procesamiento de video
// El resto del modelo (hotspots con lon/lat, tipo info/price/nav) es agnóstico al origen.
//
// Oleada 1 (personalización): Tour.design (documento de diseño v1), TourAsset (logo, video,
// audio, imágenes subidas), SceneGroup (zonas/plantas, se usa desde la Oleada 4) y columnas
// nuevas en Hotspot (style/locked/segments/content) y Scene (grupo, plano, modo de imagen).
// Todo es aditivo: columnas nulas o con default, para migrar sin perder datos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuarios ──────────────────────────────────────────────────────────────

enum GlobalRole {
  super_admin
  admin
  member
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  globalRole   GlobalRole @default(member)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tourPermissions TourPermission[]
  invitationsSent Invitation[]     @relation("InvitationCreatedBy")
  toursCreated    Tour[]           @relation("TourCreatedBy")
  exports         Export[]

  @@map("users")
}

// ── Tours y permisos ─────────────────────────────────────────────────────

model Tour {
  id            String   @id @default(uuid())
  title         String
  description   String?
  createdById   String
  theme         Json? // { accentColor, borderRadius, tooltipStyle } — Track A
  customTexts   Json? // { welcomeMessage, ctaLabel, ... } — Track A
  chatbotPrompt String? // persona del asistente por tour — Track B
  design        Json? // Design v1 (ver docs/CONTRATO_OLEADA1.md §2); null = se deriva de theme/customTexts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy    User             @relation("TourCreatedBy", fields: [createdById], references: [id])
  permissions  TourPermission[]
  scenes       Scene[]
  invitations  Invitation[]
  exports      Export[]
  videoUploads VideoUpload[]
  menuItems    TourMenuItem[]
  assets       TourAsset[]
  sceneGroups  SceneGroup[]

  @@map("tours")
}

// cliente ve y edita escenas, hotspots y apariencia. Sin tier de solo lectura: a
// diferencia del RBAC de Fase 0, aquí no existe un "viewer" por tour.
enum TourRole {
  cliente
}

model TourPermission {
  id        String   @id @default(uuid())
  tourId    String
  userId    String
  role      TourRole
  createdAt DateTime @default(now())

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tourId, userId])
  @@map("tour_permissions")
}

// Enlace de invitación con rol predefinido. El flujo de canje completo es de una fase
// posterior; el modelo existe para no romper el diseño del esquema, pero no se expone
// un endpoint de canje funcional todavía.
model Invitation {
  id           String    @id @default(uuid())
  tourId       String
  token        String    @unique @default(uuid())
  role         TourRole
  email        String?
  expiresAt    DateTime?
  createdById  String
  usedByUserId String?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  tour      Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdBy User @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  @@map("invitations")
}

// ── Video 360°, escenas y hotspots ───────────────────────────────────────

enum VideoUploadStatus {
  uploaded
  extracting
  optimizing
  done
  error
}

// Job de procesamiento de un video 360° subido (FFmpeg + Sharp). Puede generar N escenas
// de origen video_frame. El endpoint de subida end-to-end conectado a este pipeline es
// de una fase posterior; el modelo y el servicio de procesamiento se incluyen sin conectar.
model VideoUpload {
  id               String            @id @default(uuid())
  tourId           String
  originalFilename String
  storagePath      String
  status           VideoUploadStatus @default(uploaded)
  frameCount       Int?
  errorMessage     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  scenes Scene[]

  @@map("video_uploads")
}

// Origen de navegación de la escena — decide el modo del visor (continuo vs discreto).
enum SceneOrigin {
  video_frame // frame extraído de un VideoUpload — navegación continua vía timeline
  panorama_upload // panorámica subida directa — navegación discreta vía hotspots tipo nav
}

model Scene {
  id            String      @id @default(uuid())
  tourId        String
  videoUploadId String? // procedencia: de qué VideoUpload vino (solo si origen = video_frame)
  batchId       String? // agrupación de navegación secuencial (scrubber), agnóstica al origen:
  // video_frame usa el id del VideoUpload; panorama_upload en lote usa un uuid generado
  // en esa subida. Dos escenas con el mismo batchId scrubbean juntas, en orden.
  origen        SceneOrigin
  name          String? // opcional: caption en pantalla + identificador en el editor.
  // No determina por sí sola la aparición en el menú de navegación (ver TourMenuItem)
  webpPath      String // frame o panorámica, ya optimizado a WebP
  orderIndex    Int         @default(0)
  initialYaw    Float       @default(0)
  initialPitch  Float       @default(0)
  groupId       String? // zona/planta (SceneGroup) — Oleada 4
  planX         Float? // posición en el plano de la zona — Oleada 4
  planY         Float?
  planHeading   Float?
  imageMode     String? // null = usa design.panoramas.mode; "webp" | "tiles" — Oleada 2
  tiles         Json? // { width, cols, rows, dir, status } — mosaicos de alta definición
  sourcePath    String? // original subido, para regenerar mosaicos
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tour        Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  videoUpload VideoUpload?   @relation(fields: [videoUploadId], references: [id])
  group       SceneGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  hotspots    Hotspot[]
  navTargetOf Hotspot[]      @relation("HotspotTarget")
  menuItemsTo TourMenuItem[]

  @@map("scenes")
}

// Menú de navegación curado manualmente — decisión editorial, independiente de `Scene.name`.
// Un ítem puede apuntar a una escena suelta (ej. "Floor 0") o ser el punto de entrada a
// todo un grafo de escenas conectadas por hotspot (ej. "Casa Perfetta" → su primera
// escena; el resto de esa sección se recorre por hotspot, sin listarse aparte).
model TourMenuItem {
  id            String   @id @default(uuid())
  tourId        String
  label         String
  targetSceneId String
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  tour        Tour  @relation(fields: [tourId], references: [id], onDelete: Cascade)
  targetScene Scene @relation(fields: [targetSceneId], references: [id], onDelete: Cascade)

  @@map("tour_menu_items")
}

// info: título+descripción · price: título+precio+descripción · nav: salta a otra escena
// (targetSceneId). Posición fija lon/lat por escena — sin animación/keyframes por ahora.
enum PoiType {
  info
  price
  nav
}

model Hotspot {
  id            String   @id @default(uuid())
  sceneId       String
  type          PoiType
  lon           Float // grados horizontales, -180 a 180
  lat           Float // grados verticales, -85 a 85
  title         String
  description   String?
  price         String? // solo aplica si type = price
  targetSceneId String? // solo aplica si type = nav
  imagePath     String? // opcional, cualquier tipo — mismo patrón que Scene.webpPath
  style         Json? // { template, props }; null = usa el preset de su tipo en design.hotspotPresets
  locked        Boolean  @default(false) // bloqueado en el editor (no se arrastra)
  segments      Json? // rangos de cuadros donde se ve (video) — Oleada 2
  content       Json? // contenido enriquecido del panel de detalle — Oleada 2
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scene       Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  targetScene Scene? @relation("HotspotTarget", fields: [targetSceneId], references: [id])

  @@map("hotspots")
}

// Archivos subidos al tour (logo, video de fondo, póster, audio, planos). Imágenes → WebP;
// video y audio se guardan tal cual. No se aceptan SVG (pueden llevar scripts).
model TourAsset {
  id           String   @id @default(uuid())
  tourId       String
  kind         String // image | video | audio
  path         String // ruta pública, ej. /uploads/assets/<tourId>/<archivo>
  mime         String
  size         Int
  width        Int?
  height       Int?
  originalName String
  createdAt    DateTime @default(now())

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("tour_assets")
}

// Zona o planta del tour (agrupa escenas, con su plano). Se usa desde la Oleada 4.
model SceneGroup {
  id               String   @id @default(uuid())
  tourId           String
  code             String?
  name             String
  description      String?
  floorplanAssetId String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())

  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  scenes Scene[]

  @@map("scene_groups")
}

// ── Exportación ───────────────────────────────────────────────────────────

model Export {
  id          String   @id @default(uuid())
  tourId      String
  version     Int
  bundlePath  String
  createdById String
  createdAt   DateTime @default(now())

  tour      Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@map("exports")
}

// Biblioteca común de la única organización. No depende del tour de origen.
// assets contiene copias independientes de los archivos usados por el diseño.
model DesignTemplate {
  id        String   @id @default(uuid())
  name      String
  design    Json
  assets    Json
  createdAt DateTime @default(now())

  @@map("design_templates")
}
