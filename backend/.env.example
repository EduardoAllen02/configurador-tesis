DATABASE_URL="postgresql://tours:tours@localhost:5432/tour_studio"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
UPLOADS_DIR="./uploads"
EXPORTS_DIR="./exports"

# Recovery: generate a distinct random secret of at least 32 bytes. Never reuse JWT_SECRET.
PASSWORD_RESET_SECRET=""
# HTTPS application origin only, without a path. HTTP localhost is allowed outside production.
PUBLIC_APP_URL="http://localhost:5173"
# Resend API key and sender on a domain verified in your own Resend account.
RESEND_API_KEY=""
PASSWORD_RESET_FROM="Tour Studio <cuentas@your-verified-domain.example>"
PASSWORD_RESET_REPLY_TO=""
